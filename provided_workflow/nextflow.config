params {
    // REVIEW D16: defaults point at the synthetic test data shipped in data/
    genome = "${projectDir}/data/synthetic.fa"
    bed = "${projectDir}/data/synthetic.bed"
    transcript = 'synthetic.1'
    outdir = "${projectDir}/results"
}

// REVIEW D17: conda enabled globally because the spec gives conda env files, not containers
conda.enabled = true

process {
    // REVIEW D18: process_single = 1 CPU, 2 GB, 1 h; spec names labels but gives no values
    withLabel: 'process_single' {
        cpus = 1
        memory = 2.GB
        time = 1.h
    }

    // REVIEW D19: every process publishes to <outdir>/<process name, lowercase> by copy
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
    ]
}
